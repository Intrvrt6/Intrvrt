# NEVER commit the real values.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
IRENX_GATEWAY_TOKEN=replace-with-a-long-random-secret
# Optional: upstream WebSocket URL (for example a market-data bridge)
UPSTREAM_WS_URL=
# Comma-separated browser origins allowed for /ws. Empty = allow all (keep empty only behind private tunnel).
ALLOWED_ORIGINS=
